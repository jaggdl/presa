<header class="fixed inset-x-0 top-0 z-10 border-b border-zinc-800 bg-zinc-900">
  <nav class="container mx-auto flex items-center gap-8 px-5 py-4">
    <%= link_to root_path, class: "flex items-center gap-2" do %>
      <%= image_tag "presa-icon.png", alt: "Presa", class: "h-10 w-10 rounded-md object-cover" %>
      <span class="text-xl font-semibold">Presa</span>
    <% end %>
    <div class="flex items-center gap-4 text-sm">
      <%= link_to "Workspaces", workspaces_path %>
      <%= link_to "Services", services_path %>
      <%= link_to "Credentials", oauth_client_credentials_path %>
    </div>
  </nav>
</header>