<% if token = flash[:token] %>
  <div class="py-2 px-3 bg-yellow-950 mb-3 text-yellow-300 font-medium rounded-lg" id="created-token-label">
    API token created. Copy it now — it won't be shown again:
  </div>
  <pre class="py-2 px-3 bg-zinc-800 rounded-lg mb-5 overflow-x-auto select-all" id="created-token"><%= token %></pre>
<% end %>

<% if flash[:notice] %>
  <p class="py-2 px-3 bg-green-950 mb-5 text-green-400 font-medium rounded-lg" id="notice"><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
  <p class="py-2 px-3 bg-red-950 mb-5 text-red-400 font-medium rounded-lg" id="alert"><%= flash[:alert] %></p>
<% end %>