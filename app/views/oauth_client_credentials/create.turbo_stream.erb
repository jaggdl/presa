<% if @credential.persisted? %>
  <%= turbo_stream.remove "new-oauth-client-dialog" %>

  <%= turbo_stream.replace "oauth_client_credential_select" do %>
    <%= select_tag :oauth_client_credential_id,
          options_for_select(@clients.map { |c| [ c.name, c.id ] } + [ [ "Create a new client…", "new" ] ], @credential.id),
          id: "oauth_client_credential_select",
          include_blank: "Choose a #{@credential.provider.humanize} OAuth client…",
          class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-2 w-full bg-zinc-900",
          data: { oauth_client_target: "choose", action: "oauth-client#onChange" } %>
  <% end %>

  <%= turbo_stream.update "new-oauth-client-success" do %>
    <p class="text-xs text-emerald-400">Added “<%= @credential.name %>”.</p>
  <% end %>
<% else %>
  <%= turbo_stream.update "new-oauth-client-form" do %>
    <%= render "oauth_client_credentials/modal_form", credential: @credential %>
  <% end %>
<% end %>