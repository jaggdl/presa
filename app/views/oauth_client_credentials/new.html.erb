<div class="mx-auto md:w-3/4 w-full">
  <p class="text-sm text-zinc-500 mb-2">
    <%= link_to "Services", services_path, class: "text-blue-500 hover:underline" %> · OAuth client
  </p>
  <h1 class="font-bold text-4xl">Add OAuth client</h1>

  <p class="text-zinc-400 mt-2 text-sm">
    Register an OAuth app with <em><%= @credential.provider.humanize %></em> and
    paste its credentials here. You'll connect your service through this client.
  </p>

  <div class="mt-4 p-4 rounded-lg border border-zinc-700 bg-zinc-900">
    <span class="block text-sm text-zinc-400">Add this as the redirect URI in your <%= @credential.provider.humanize %> app</span>
    <div class="mt-2 flex items-center gap-2">
      <code class="text-xs bg-zinc-800 px-2 py-1 rounded break-all flex-1"><%= oauth_callback_url %></code>
      <button type="button"
              class="px-2 py-1 rounded text-xs text-zinc-400 hover:text-zinc-100 hover:bg-zinc-700 transition"
              data-controller="copy"
              data-copy-value="<%= oauth_callback_url %>"
              data-action="click->copy#copy">Copy</button>
    </div>
  </div>

  <%= render "form", credential: @credential %>
</div>