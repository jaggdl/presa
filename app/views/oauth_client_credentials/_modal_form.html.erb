<% provider_name = credential.provider.to_s.humanize %>
<%= form_with model: credential, scope: :oauth_client_credential, url: oauth_client_credentials_path do |form| %>
  <%= form.hidden_field :provider %>
  <%= hidden_field_tag :modal, "1" %>

  <% if credential.errors.any? %>
    <div class="py-2 px-3 bg-red-950 mb-4 rounded-lg">
      <ul class="text-red-400 list-disc list-inside text-sm">
        <% credential.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-4">
    <%= form.label :name, "Client name", class: "block text-sm text-zinc-400 mb-1" %>
    <%= form.text_field :name, placeholder: "e.g. Prod #{provider_name} app", autocomplete: "off", class: "block w-full shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-800" %>
  </div>

  <div class="my-4">
    <%= form.label :client_id, "Client ID", class: "block text-sm text-zinc-400 mb-1" %>
    <%= form.text_field :client_id, autocomplete: "off", class: "block w-full shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-800" %>
  </div>

  <div class="my-4">
    <%= form.label :client_secret, "Client secret", class: "block text-sm text-zinc-400 mb-1" %>
    <%= form.password_field :client_secret, autocomplete: "new-password", class: "block w-full shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-800" %>
  </div>

  <div class="my-4">
    <span class="block text-xs text-zinc-400 mb-1">Redirect URI</span>
    <div class="mt-1"><%= render "shared/copy_block", content: oauth_callback_url %></div>
  </div>

  <div class="mt-4 flex justify-end gap-2">
    <button type="button" data-action="oauth-client#closeDialog"
            class="px-3 py-2 rounded-md border border-zinc-700 text-zinc-300 hover:bg-zinc-800 text-sm">Cancel</button>
    <%= form.submit "Save client", class: "btn-primary" %>
  </div>
<% end %>