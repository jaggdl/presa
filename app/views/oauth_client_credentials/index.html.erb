<div class="mx-auto md:w-3/4 w-full">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-4xl">Credentials</h1>
    <%= link_to "Add credential", new_oauth_client_credential_path, class: "btn-primary" %>
  </div>

  <p class="text-zinc-400 mt-2 text-sm">
    OAuth client apps you've registered to back your services (e.g. Google OAuth clients).
    Each service is connected through one of these.
  </p>

  <% if @credentials.any? %>
    <table class="w-full text-left mt-6">
      <thead>
        <tr class="text-zinc-500 text-sm border-b border-zinc-800">
          <th class="py-2">Name</th>
          <th class="py-2">Provider</th>
          <th class="py-2">Client ID</th>
          <th class="py-2 text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @credentials.each do |cred| %>
          <tr class="border-b border-zinc-800">
            <td class="py-3 text-zinc-100"><%= cred.name %></td>
            <td class="py-3 text-zinc-400"><%= cred.provider %></td>
            <td class="py-3 text-zinc-400"><code class="text-xs"><%= cred.client_id %></code></td>
            <td class="py-3 text-right">
              <%= button_to "Remove", oauth_client_credential_path(cred),
                method: :delete, class: "text-red-400 text-xs underline hover:no-underline",
                form: { data: { turbo_confirm: "Remove this OAuth client?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-6">No OAuth clients yet.</p>
  <% end %>
</div>