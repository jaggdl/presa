<div class="mx-auto md:w-3/4 w-full">
  <h1 class="font-bold text-4xl">Credentials</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    <% @providers.each do |p| %>
      <%= link_to new_oauth_client_credential_path(provider: p[:provider].to_s), class: "flex items-center gap-3 p-4 rounded-lg border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 transition" do %>
        <%= oauth_provider_icon(p[:provider].to_s, size: "h-9 w-9") %>
        <span class="flex-1 min-w-0 truncate font-medium text-zinc-100"><%= p[:provider].to_s.humanize %></span>
        <%= icon "plus", class: "size-6 text-zinc-500" %>
      <% end %>
    <% end %>
  </div>

  <% if @credentials.any? %>
    <h2 class="font-bold text-2xl mt-10">Your credentials</h2>
    <table class="w-full text-left mt-4">
      <tbody>
        <% @credentials.each do |cred| %>
          <tr class="border-b border-zinc-800">
            <td class="py-2">
              <div class="flex items-center gap-3">
                <%= oauth_provider_icon(cred.provider, size: "h-5 w-5") %>
                <div>
                  <%= link_to cred.name, edit_oauth_client_credential_path(cred), class: "text-blue-500 hover:underline" %>
                  <div class="text-xs text-zinc-500"><%= cred.provider %></div>
                </div>
              </div>
            </td>
            <td class="py-2 text-right">
              <%= button_to oauth_client_credential_path(cred), method: :delete,
                    class: "p-2 rounded-md text-zinc-500 hover:text-red-400 hover:bg-zinc-800 transition",
                    aria: { label: "Remove #{cred.name}" },
                    form: { data: { turbo_confirm: "Remove this OAuth client?" } } do %>
                <%= icon "trash", class: "h-4 w-4" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-6">No OAuth clients yet.</p>
  <% end %>
</div>