<div id="openapi-wizard" data-openapi-dialog-target="panel">
  <div class="flex items-center justify-between mb-2">
    <h3 class="font-bold text-lg">Add OpenAPI integration</h3>
    <button type="button" data-action="openapi-dialog#close" class="text-zinc-400 hover:text-zinc-200 transition" aria-label="Close">
      <%= icon "x", class: "size-5" %>
    </button>
  </div>

  <% if local_assigns[:error] %>
    <div class="py-2 px-3 bg-red-950 mb-4 rounded-lg text-sm text-red-400">
      <%= error %>
    </div>
  <% end %>

  <%= form_with url: openapi_parse_path, method: :post, class: "contents" do |form| %>
    <div class="my-4">
      <%= form.label :spec, "OpenAPI spec", class: "block text-sm text-zinc-400" %>
      <div class="flex gap-2 mt-2">
        <%= select_tag :source, options_for_select([ [ "From a URL", "url" ], [ "Paste JSON/YAML", "raw" ] ], local_assigns[:source] || "url"),
              class: "block rounded-md border border-zinc-700 focus:outline-blue-600 px-2 py-2 bg-zinc-900", data: { openapi_dialog_target: "source", action: "openapi-dialog#syncPlaceholder" } %>
        <%= form.text_field :spec, id: "openapi_spec",
              value: local_assigns[:spec],
              placeholder: "https://api.example.com/openapi.json or pasted JSON/YAML",
              autocomplete: "off", autofocus: true, required: true,
              data: { openapi_dialog_target: "spec" },
              class: "block w-full rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-900 placeholder-zinc-500" %>
      </div>
      <p class="text-xs text-zinc-500 mt-2">Paste a URL or raw JSON/YAML content.</p>
    </div>

    <details class="my-4 text-sm">
      <summary class="cursor-pointer text-zinc-400 hover:text-zinc-200">Spec overrides</summary>
      <div class="mt-3">
        <label class="block text-sm text-zinc-400" for="openapi_base_url">Base URL override (optional)</label>
        <input type="text" id="openapi_base_url" name="base_url" placeholder="https://api.example.com" autocomplete="off"
               class="block w-full rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-1 bg-zinc-900 placeholder-zinc-500">
      </div>
    </details>

    <div class="flex items-center justify-end gap-3 mt-6">
      <button type="button" data-action="openapi-dialog#close" class="rounded-md px-3.5 py-2 text-zinc-400 hover:text-zinc-200 transition">Cancel</button>
      <button type="submit" class="btn-primary">Add integration</button>
    </div>
  <% end %>
</div>