<div id="openapi-wizard" data-openapi-dialog-target="panel">
  <div class="flex items-center justify-between mb-3">
    <h3 class="font-bold text-lg">Configure integration</h3>
    <button type="button" data-action="openapi-dialog#close" class="text-zinc-400 hover:text-zinc-200 transition" aria-label="Close">
      <%= icon "x", class: "size-5" %>
    </button>
  </div>

  <% if local_assigns[:entity]&.errors&.any? %>
    <div class="py-2 px-3 bg-red-950 mb-4 rounded-lg text-sm text-red-400">
      <ul class="list-disc list-inside">
        <% local_assigns[:entity].errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex items-center gap-3 p-3 rounded-lg border border-zinc-700 bg-zinc-900 mb-4">
    <div class="min-w-0 flex-1">
      <span class="block truncate font-medium capitalize text-zinc-100"><%= definition["title"] %><% if definition["version"].present? %> · <%= definition["version"] %><% end %></span>
      <span class="text-xs text-zinc-500"><%= pluralize(definition["operation_count"], "operation") %> · <%= pluralize(definition["tag_count"], "tag") %> — creating a reusable kind. Services of it are added from the picker afterwards.</span>
    </div>
  </div>

  <%= form_with url: openapi_create_kind_path, method: :post, class: "contents" do |form| %>
    <%= hidden_field_tag :draft_token, local_assigns[:token] %>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-3">
      <div class="my-2">
        <%= label_tag :display_name, "Display Name", class: "block text-sm text-zinc-400" %>
        <%= text_field_tag "integration[name]", local_assigns[:entity]&.name || definition["title"], autocomplete: "off",
              class: "block w-full rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-1 bg-zinc-900" %>
      </div>
      <div class="my-2">
        <%= label_tag :namespace, "Namespace (tool prefix)", class: "block text-sm text-zinc-400" %>
        <%= text_field_tag "integration[namespace]", local_assigns[:entity]&.namespace.presence || definition["namespace_slug"], autocomplete: "off", pattern: "[a-z0-9_]+",
              class: "block w-full rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-1 bg-zinc-900 font-mono" %>
      </div>
    </div>

    <div class="my-2">
      <%= label_tag :description, "Description", class: "block text-sm text-zinc-400" %>
      <%= text_field_tag "integration[description]", definition["description"], autocomplete: "off",
            class: "block w-full rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-1 bg-zinc-900" %>
    </div>

    <div class="my-2">
      <%= label_tag :base_url, "Base URL override (optional)", class: "block text-sm text-zinc-400" %>
      <%= text_field_tag "integration[base_url]", definition["base_url"], autocomplete: "off", placeholder: "https://api.example.com",
            class: "block w-full rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-1 bg-zinc-900 placeholder-zinc-500" %>
    </div>

    <% if definition["spec_url"].present? %>
      <div class="my-2">
        <span class="block text-sm text-zinc-400">Spec URL</span>
        <code class="block text-xs text-zinc-500 mt-1 break-all"><%= definition["spec_url"] %></code>
      </div>
    <% end %>

    <div class="my-4">
      <span class="block text-sm text-zinc-400">How does this API authenticate?</span>

      <div class="mt-2 space-y-1">
        <% (definition["security"] || {}).each do |scheme_name, slot| %>
          <div class="flex items-center justify-between gap-3 py-1.5 px-2 rounded-md bg-zinc-900 border border-zinc-800">
            <code class="text-xs text-zinc-300"><%= scheme_name %></code>
            <span class="text-xs text-zinc-500 font-mono"><%= auth_send_hint(slot) %></span>
          </div>
        <% end %>

        <p class="text-xs text-zinc-500 pt-1">Credentials aren't entered yet — add the integration first, then connect an account on its page.</p>
      </div>
    </div>

    <div class="my-4">
      <span class="block text-sm text-zinc-400">Health check (optional)</span>
      <div class="mt-1">
        <%= label_tag :health_op, "Operation", class: "block text-xs text-zinc-500" %>
        <%= select_tag "integration[health_op]",
              options_for_select(health_op_options(definition), local_assigns[:entity]&.health_op),
              include_blank: "None — health check only",
              class: "block w-full rounded-md border border-zinc-700 focus:outline-blue-600 px-2 py-2 mt-1 bg-zinc-900 text-sm" %>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 mt-6">
      <button type="button" data-action="openapi-dialog#close" class="rounded-md px-3.5 py-2 text-zinc-400 hover:text-zinc-200 transition">Cancel</button>
      <button type="submit" class="btn-primary">Create integration</button>
    </div>
  <% end %>
</div>