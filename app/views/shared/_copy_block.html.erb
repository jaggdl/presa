<div class="relative <%= local_assigns[:wrapper_class] %>" data-controller="copy">
  <pre data-copy-target="source"
       class="text-sm text-zinc-200 overflow-x-auto select-all whitespace-pre-wrap break-all rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 pr-12"><%= content %></pre>
  <button type="button" data-action="click->copy#copy"
          class="absolute top-1.5 right-1.5 p-1.5 rounded text-zinc-400 hover:text-zinc-100 hover:bg-zinc-700 transition"
          aria-label="Copy to clipboard">
    <span data-copy-target="idle"><%= icon "copy", class: "size-4" %></span>
    <span data-copy-target="done" class="hidden"><%= icon "circle-check", class: "size-4" %></span>
  </button>
</div>