<div class="<%= local_assigns[:wrapper_class] %>" data-controller="copy">
  <pre data-copy-target="source"
       class="text-xs text-zinc-200 overflow-x-auto select-all whitespace-pre-wrap break-all rounded-md border border-zinc-700 bg-zinc-950 px-3 py-2 pr-16"><%= content %></pre>
  <button type="button" data-copy-target="label" data-action="click->copy#copy"
          class="absolute top-1.5 right-1.5 px-2 py-1 rounded text-xs text-zinc-400 hover:text-zinc-100 hover:bg-zinc-700 transition">Copy</button>
</div>