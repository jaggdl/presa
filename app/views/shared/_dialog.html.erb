<%# Shared native <dialog> shell with Presa's standard card chrome.
    locals:
      controller:  stimulus controller providing the `backdrop` action and the `dialog` target
      id:          optional dialog id
      width_class: width class for the card (default "w-[26rem]") %>

<dialog <% if local_assigns[:id] %>id="<%= id %>" <% end %>data-<%= controller %>-target="dialog"
        data-action="click-><%= controller %>#backdrop"
        class="m-auto p-0 rounded-lg bg-transparent border-0 backdrop:bg-black/60 data-[open]:backdrop:bg-black/60 open:backdrop:bg-black/60">
  <div class="p-6 rounded-lg bg-zinc-900 text-zinc-100 border border-zinc-700 <%= local_assigns[:width_class] || "w-[26rem]" %> max-w-[92vw]">
    <%= yield %>
  </div>
</dialog>