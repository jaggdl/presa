<div class="mx-auto md:w-3/4 w-full">
  <p class="text-sm text-zinc-500 mb-2">
    <%= link_to "Services", services_path, class: "text-blue-500 hover:underline" %>
  </p>
  <h1 class="font-bold text-4xl"><%= service_icon(@service, size: "h-14 w-14") %><span class="ml-3 inline-flex items-center"><%= @service.name %></span></h1>

  <dl class="mt-8">
    <div class="py-2 border-b border-zinc-800">
      <dt class="text-sm text-zinc-500">Kind</dt>
      <dd><%= @service.kind %></dd>
    </div>
    <div class="py-2 border-b border-zinc-800">
      <dt class="text-sm text-zinc-500">Workspaces</dt>
      <dd>
        <% joins = @service.workspace_services.includes(:workspace).to_a %>
        <% if joins.any? %>
          <% joins.each do |join| %>
            <%= link_to join.workspace.name, workspace_workspace_service_path(join.workspace, join), class: "text-blue-500 hover:underline" %><%= "," unless join.equal?(joins.last) %>
          <% end %>
        <% else %>
          None
        <% end %>
      </dd>
    </div>
  </dl>

  <% if @service.is_a?(OauthService) %>
    <%= render "services/oauth", service: @service %>
  <% end %>

  <% if @service.description.present? %>
    <div class="mt-8">
      <%= render_markdown(@service.description) %>
    </div>
  <% end %>

  <h2 class="font-bold text-2xl mt-10">Tools</h2>

  <% if @service.respond_to?(:remote_tools_error) && @service.remote_tools_error.present? %>
    <div class="mt-4 py-3 px-4 rounded-lg border border-red-500/30 bg-red-950/40 text-red-400 text-sm">
      Couldn't reach this service's MCP endpoint: <%= h @service.remote_tools_error.message %>
    </div>
  <% end %>

  <% if @tools.any? %>
    <ul class="mt-4">
      <% @tools.each do |tool| %>
        <li class="py-3 border-b border-zinc-800">
          <code class="text-sm text-blue-500"><%= tool.tool_name %></code>
          <% if description = tool.description %>
            <p class="text-sm text-zinc-400 mt-1"><%= description %></p>
          <% end %>

          <% if (params = tool.input_parameters).any? %>
            <ul class="mt-3 space-y-1">
              <% params.each do |param| %>
                <li class="text-sm">
                  <code class="text-zinc-300"><%= param[:name] %></code>
                  <span class="text-zinc-500"><%= param[:type] %><%= param[:required] ? "" : "?" %></span>
                  <% if param[:required] %>
                    <span class="text-red-400">required</span>
                  <% end %>
                  <% if param[:description] %>
                    <span class="text-zinc-500">— <%= param[:description] %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-sm text-zinc-500 mt-1">Accepts no arguments.</p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-zinc-500 mt-4">No tools available for this service.</p>
  <% end %>

  <div class="mt-8">
    <%= link_to "Edit", edit_service_path(@service), class: "text-blue-500 underline hover:no-underline mr-3" %>
    <%= link_to "Back", services_path, class: "text-zinc-400 underline hover:no-underline" %>
  </div>
</div>