<div id="service-test-status" class="mt-3 flex items-center gap-2 text-sm">
  <% if connected %>
    <span class="inline-block h-3 w-3 rounded-full bg-green-400" aria-hidden="true"></span>
    <span class="text-green-400">Connected successfully.</span>
  <% else %>
    <span class="inline-block h-3 w-3 rounded-full bg-red-500" aria-hidden="true"></span>
    <span class="text-red-400">Connection failed: <%= message %></span>
  <% end %>
</div>