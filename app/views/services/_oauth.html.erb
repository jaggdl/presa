<% if @service.connected? %>
  <div class="flex items-center gap-3 py-2">
    <span class="text-sm text-emerald-400">● Connected</span>
    <% if (cred = @service.oauth_grant&.oauth_client_credential) %>
      <span class="text-sm text-zinc-300">via <%= cred.name %></span>
    <% end %>
  </div>
<% else %>
  <div class="py-2">
    <p class="text-sm text-amber-400">○ Not connected yet.</p>
    <% creds = Current.user.oauth_client_credentials.where(provider: @service.provider).to_a %>
    <% if creds.any? %>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <% creds.each do |cred| %>
          <%= button_to "Connect with #{cred.name}",
                oauth_start_path(service_id: @service.id, oauth_client_credential_id: cred.id),
                class: "btn-primary text-sm", data: { turbo: false } %>
        <% end %>
      </div>
    <% end %>
    <%= link_to "Add an OAuth client", new_oauth_client_credential_path(provider: @service.provider, return_to: service_path(@service)),
                class: "text-sm text-blue-500 underline hover:no-underline mt-3" %>
  </div>
<% end %>