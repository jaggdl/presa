<% if service.errors.any? %>
  <div class="py-2 px-3 bg-red-50 mb-5 rounded-lg">
    <h2 class="text-red-500 font-medium"><%= pluralize(service.errors.count, "error") %> prohibited this service from being saved:</h2>
    <ul class="text-red-500 list-disc list-inside mt-2">
      <% service.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: service, url: (service.persisted? ? service_path(service) : services_path), class: "contents" do |form| %>
  <div class="my-5">
    <%= form.label :name, "Name", class: "block text-sm text-gray-600" %>
    <%= form.text_field :name, placeholder: "e.g. Prod", autofocus: true, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
  </div>

  <% unless service.persisted? %>
    <div class="my-5">
      <%= form.label :kind, "Kind", class: "block text-sm text-gray-600" %>
      <%= form.select :kind, Service.kinds.map { |k| [k.humanize, k] }, {}, class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
    </div>
  <% end %>

  <% service.config_schema.each do |field, opts| %>
    <div class="my-5">
      <%= form.label "config[#{field}]", field.humanize, class: "block text-sm text-gray-600" %>
      <% if opts[:secret] %>
        <%= form.password_field "config[#{field}]", value: service.config[field], placeholder: opts[:secret] ? "••••••••" : "", class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <% else %>
        <%= form.text_field "config[#{field}]", value: service.config[field], class: "block shadow-sm rounded-md border border-gray-400 focus:outline-blue-600 px-3 py-2 mt-2 w-full" %>
      <% end %>
    </div>
  <% end %>

  <div class="inline">
    <%= form.submit "Save service", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>