<% if service.errors.any? %>
  <div class="py-2 px-3 bg-red-950 mb-5 rounded-lg">
    <h2 class="text-red-400 font-medium"><%= pluralize(service.errors.count, "error") %> prohibited this service from being saved:</h2>
    <ul class="text-red-400 list-disc list-inside mt-2">
      <% service.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: service, scope: :service, url: (service.persisted? ? service_path(service) : services_path), class: "contents" do |form| %>
  <div class="my-5">
    <%= form.label :name, "Name", class: "block text-sm text-zinc-400" %>
    <%= form.text_field :name, placeholder: "e.g. Prod", autofocus: true, class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-2 w-full bg-zinc-900" %>
  </div>

  <% unless service.persisted? %>
    <div class="my-5">
      <%= form.label :kind, "Kind", class: "block text-sm text-zinc-400" %>
      <%= form.select :kind, Service.kinds.map { |k| [k.humanize, k] }, {}, class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-2 w-full bg-zinc-900" %>
    </div>
  <% end %>

  <%= form.fields_for :config do |cf| %>
    <% service.config_schema.each do |field, opts| %>
      <div class="my-5">
        <%= cf.label field, field.humanize, class: "block text-sm text-zinc-400" %>
        <% if opts[:secret] %>
          <%= cf.password_field field, value: service.config[field], placeholder: "••••••••", class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-2 w-full bg-zinc-900" %>
        <% else %>
          <%= cf.text_field field, value: service.config[field], class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-2 w-full bg-zinc-900" %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="inline">
    <%= form.submit "Save service", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>