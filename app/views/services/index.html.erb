<div class="mx-auto md:w-3/4 w-full">
  <div class="flex items-center justify-between gap-4">
    <h1 class="font-bold text-4xl">Services</h1>
    <%= form_with url: services_path, method: :get, data: { controller: "services-search", turbo_stream: true } do |form| %>
      <div class="relative w-full max-w-xs">
        <%= icon "search", class: "size-4 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500" %>
        <%= form.search_field :q, value: params[:q], autocomplete: "off",
              data: { services_search_target: "input", action: "input->services-search#submit" },
              placeholder: "Search services",
              class: "w-full pl-9 pr-3 py-2 rounded-md border border-zinc-700 bg-zinc-800 text-zinc-100 focus:outline-blue-600 placeholder-zinc-500" %>
      </div>
    <% end %>
  </div>

  <%= render "services/kinds_grid", kinds: @kinds, q: @q %>
  <%= render "services/kinds_more", q: @q, offset: @offset + @kinds.length, show_more: @show_more %>

  <% if @services.any? %>
    <h2 class="font-bold text-2xl mt-10">Configured services</h2>
    <div class="mt-4">
      <% @services.each do |service| %>
        <div class="relative flex items-center justify-between gap-3 py-2 pl-2 pr-2 rounded-lg border-b border-zinc-800 hover:bg-zinc-800/50 focus-within:bg-zinc-800/50 transition">
          <%= link_to "", service_path(service), class: "absolute inset-0", aria: { label: service.name } %>
          <div class="flex items-center gap-3">
            <span class="relative flex-shrink-0">
              <%= service_icon(service, size: :md) %>
              <%= render "shared/tool_count_badge", title: "Available tools", count: ApplicationTool.expose_for(service).count, label: "available" %>
            </span>
            <div>
              <span class="block font-medium text-zinc-100"><%= service.name %></span>
              <div class="text-xs text-zinc-500"><%= service.kind %></div>
            </div>
          </div>
          <span class="inline-flex items-center justify-end gap-1.5 shrink-0">
            <%= render "shared/workspace_count_badge", title: "Linked workspaces", count: service.workspaces.size, label: "workspace" %>
            <span class="pill"><%= icon "activity", class: "size-3" %><%= pluralize(service.invocation_count, "invocation") %> in 24h</span>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-zinc-500 mt-6">No services yet.</p>
  <% end %>
</div>