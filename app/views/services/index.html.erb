<div class="mx-auto md:w-3/4 w-full">
  <h1 class="font-bold text-4xl">Services</h1>

  <div class="mt-6">
    <%= link_to "New service", new_service_path, class: "text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium" %>
  </div>

  <% if @services.any? %>
    <table class="w-full text-left mt-8">
      <thead>
        <tr class="border-b border-zinc-800 text-sm text-zinc-500">
          <th class="py-2">Name</th>
          <th class="py-2">Kind</th>
          <th class="py-2">Workspaces</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody>
        <% @services.each do |service| %>
          <tr class="border-b border-zinc-800">
            <td class="py-2"><%= link_to service.name, service_path(service), class: "text-blue-500 hover:underline" %></td>
            <td class="py-2"><%= service.kind %></td>
            <td class="py-2"><%= service.workspaces.map(&:name).presence&.join(", ") || "–" %></td>
            <td class="py-2 text-right">
              <%= link_to "Edit", edit_service_path(service), class: "text-zinc-400 underline hover:no-underline mr-3" %>
              <%= button_to "Delete", service_path(service), method: :delete, class: "text-red-400 underline hover:no-underline", form: { data: { turbo_confirm: "Delete this service?" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-6">No services yet.</p>
  <% end %>
</div>