<div class="mx-auto md:w-3/4 w-full">
  <h1 class="font-bold text-4xl">Services</h1>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    <% @kinds.each do |kind| %>
      <% klass = Service.class_for_kind(kind) %>
      <%= link_to new_kind_service_services_path(kind), class: "relative flex items-center gap-3 p-4 rounded-lg border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 transition" do %>
        <%= render "services/header", service: klass.new %>
        <%= icon "plus", class: "size-6 text-zinc-500" %>
      <% end %>
    <% end %>
  </div>

  <% if @services.any? %>
    <h2 class="font-bold text-2xl mt-10">Configured services</h2>
    <div class="mt-4">
      <% @services.each do |service| %>
        <div class="relative flex items-center justify-between gap-3 py-2 pl-2 pr-2 rounded-lg border-b border-zinc-800 hover:bg-zinc-800/50 focus-within:bg-zinc-800/50 transition">
          <%= link_to "", service_path(service), class: "absolute inset-0", aria: { label: service.name } %>
          <div class="flex items-center gap-3">
            <span class="relative flex-shrink-0">
              <%= service_icon(service, size: :md) %>
              <%= render "shared/tool_count_badge", title: "Available tools", count: ApplicationTool.expose_for(service).count, label: "available" %>
            </span>
            <div>
              <span class="block font-medium text-zinc-100"><%= service.name %></span>
              <div class="text-xs text-zinc-500"><%= service.kind %></div>
            </div>
          </div>
          <span class="inline-flex items-center justify-end gap-2 text-xs text-zinc-500">
            <%= render "shared/workspace_count_badge", title: "Linked workspaces", count: service.workspaces.size, label: "workspace" %>
            <span><%= pluralize(service.invocation_count, "invocation") %> in 24h</span>
          </span>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-zinc-500 mt-6">No services yet.</p>
  <% end %>
</div>