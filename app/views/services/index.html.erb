<div class="mx-auto md:w-3/4 w-full">
  <h1 class="font-bold text-4xl">Services</h1>

  <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-8">
    <% @kinds.each do |kind| %>
      <%= link_to new_kind_service_services_path(kind), class: "flex items-center gap-3 p-4 rounded-lg border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 transition" do %>
        <%= service_icon(Service.class_for_kind(kind).new, size: "h-9 w-9") %>
        <span class="font-medium text-zinc-100 mr-auto"><%= kind.humanize %></span>
        <%= icon "plus", class: "size-6 text-zinc-500" %>
      <% end %>
    <% end %>
  </div>

  <% if @services.any? %>
    <h2 class="font-bold text-2xl mt-10">Your services</h2>
    <table class="w-full text-left mt-4">
      <tbody>
        <% @services.each do |service| %>
          <tr class="border-b border-zinc-800">
            <td class="py-2">
              <div class="flex items-center gap-3">
                <%= service_icon(service, size: "h-5 w-5") %>
                <%= link_to service.name, service_path(service), class: "text-blue-500 hover:underline" %>
                <span class="text-zinc-500"><%= service.kind %></span>
                <%= render "shared/tool_count_badge", title: "Available tools", count: ApplicationTool.expose_for(service).count, label: "available" %>
              </div>
            </td>
            <td class="py-2 text-right">
              <span class="text-xs text-zinc-500">
                <span class="text-zinc-400">Used in <%= pluralize(service.workspaces.count, "workspace") %></span> · <%= pluralize(service.invocation_count, "invocation") %> in 24h
              </span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-6">No services yet.</p>
  <% end %>
</div>