<div class="mx-auto md:w-3/4 w-full">
  <div class="flex items-center justify-between gap-4">
    <h1 class="font-bold text-4xl">Services</h1>
    <%= form_with url: services_path, method: :get, data: { controller: "services-search", turbo_stream: true } do |form| %>
      <div class="relative w-full max-w-xs">
        <%= icon "search", class: "size-4 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500" %>
        <%= form.search_field :q, value: params[:q], autocomplete: "off",
              data: { services_search_target: "input", action: "input->services-search#submit" },
              placeholder: "Search services",
              class: "w-full pl-9 pr-3 py-2 rounded-md border border-zinc-700 bg-zinc-800 text-zinc-100 focus:outline-blue-600 placeholder-zinc-500" %>
      </div>
    <% end %>
  </div>

  <h2 class="font-bold text-2xl mt-8">Add a service</h2>

  <%= render "services/kinds_grid", kinds: @kinds, q: @q %>
  <%= render "services/kinds_more", q: @q, offset: @offset + @kinds.length, show_more: @show_more %>

  <div data-controller="openapi-dialog">
    <button type="button" data-action="openapi-dialog#open"
            class="relative flex items-center gap-3 p-4 rounded-lg border border-dashed border-zinc-600 bg-zinc-900/60 hover:bg-zinc-800 transition w-full text-left">
      <div class="flex items-start gap-3 min-w-0 flex-1 pr-2">
        <span class="relative inline-flex items-center justify-center shrink-0 p-2 h-8 w-8 bg-zinc-900 rounded-md border border-zinc-700">
          <%= icon "braces", class: "size-5 text-zinc-400" %>
        </span>
        <div class="min-w-0 flex-1">
          <span class="block truncate font-medium text-zinc-100">OpenAPI integration</span>
          <p class="mt-1 text-xs leading-relaxed text-zinc-500">Generate a service from any OpenAPI 3.x spec — URL or pasted JSON/YAML.</p>
        </div>
      </div>
      <%= icon "plus", class: "size-6 text-zinc-500 shrink-0" %>
    </button>

    <%= render "shared/dialog", controller: "openapi-dialog", id: "openapi-dialog", width_class: "w-[38rem]" do %>
      <%= render "openapi_integrations/step1" %>
    <% end %>
  </div>

  <div id="configured-services" class="mt-4">
    <%= render "services/configured_services", services: @services %>
  </div>
</div>