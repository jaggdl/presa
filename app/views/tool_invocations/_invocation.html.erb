<li data-controller="invocation" class="text-left cursor-pointer<%= ' inv-flash' if local_assigns[:flash] %>">
  <div data-action="click->invocation#toggle" class="flex items-center gap-2 pl-1 pr-3 py-1 whitespace-nowrap">
    <%= service_icon(invocation.service, size: :sm) if invocation.service %>
    <span class="text-zinc-500"><%= invocation.created_at.strftime("%H:%M:%S") %></span>
    <%= tag.span invocation.tool_name, class: (invocation.success? ? "text-zinc-400" : "text-red-400/70") %>
    <span class="text-zinc-500"><%= invocation.duration_ms ? "#{invocation.duration_ms} ms" : "–" %></span>
    <code class="text-zinc-400 flex-1 min-w-0 truncate"><%= truncate(format_invocation_arguments(invocation.arguments), length: 60) %></code>
    <span class="text-zinc-500"><%= invocation.api_token.name.presence || "–" %></span>
    <span class="text-zinc-500"><%= icon "chevron-down", class: "size-3.5" %></span>
  </div>

  <div data-invocation-target="details" class="hidden border-t border-zinc-800/60 px-4 py-2 space-y-2">
    <% unless invocation.success? %>
      <div>
        <div class="text-red-400/70">Error</div>
        <div class="text-red-300/90 break-all"><%= invocation.error_message.presence || "Tool failed" %></div>
      </div>
    <% end %>
    <div>
      <div class="text-zinc-500">Arguments</div>
      <code class="text-zinc-300 break-all"><%= format_invocation_arguments(invocation.arguments) %></code>
    </div>
  </div>
</li>
