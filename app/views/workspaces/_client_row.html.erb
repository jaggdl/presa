<tr id="<%= dom_id(api_token, "client") %>" class="border-b border-zinc-800 <%= api_token.revoked? ? "hidden group-data-[clients-show-revoked-value=true]:table-row" : "" %>">
  <td class="py-2">
    <div class="flex items-center gap-3">
      <%= icon "monitor", class: "size-5 text-zinc-500" %>
      <span class="font-medium"><%= api_token.name.presence || "Unnamed client" %></span>
      <span class="inline-flex items-center gap-1.5 text-xs">
        <% if api_token.revoked? %>
          <span class="inline-block size-2 rounded-full bg-red-500"></span>
          <span class="text-red-500">Revoked</span>
        <% elsif api_token.expired? %>
          <span class="inline-block size-2 rounded-full bg-yellow-400"></span>
          <span class="text-yellow-400">Expired</span>
        <% else %>
          <span class="inline-block size-2 rounded-full bg-green-400"></span>
          <span class="text-green-400">Active</span>
        <% end %>
      </span>
      <span class="text-xs text-zinc-500"><%= pluralize(api_token.invocation_count, "invocation") %> in 24h</span>
    </div>
  </td>
  <td class="py-2 text-xs text-zinc-500">
    <% if api_token.last_used_at %>
      Last used <%= time_ago_in_words(api_token.last_used_at) %> ago
    <% else %>
      Never used
    <% end %>
  </td>
  <td class="py-2 text-right text-xs text-zinc-500">
    <div class="flex items-center justify-end gap-2">
      <% if api_token.last_used_at || api_token.expires_at || api_token.created_at %>
        <span>
          <%= api_token.created_at ? "created #{api_token.created_at.strftime("%b %d, %Y")}" : "" %>
          <% if api_token.expires_at %>
            · expires <%= api_token.expires_at.strftime("%b %d, %Y") %>
          <% end %>
        </span>
      <% end %>
      <% if api_token.active? %>
        <%= button_to workspace_api_token_path(workspace, api_token), method: :delete, class: "text-zinc-400 hover:text-red-400 transition", form: { data: { turbo_confirm: "Revoke this token?" } }, "aria-label": "Revoke token" do %>
          <%= icon "trash", class: "size-4" %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>