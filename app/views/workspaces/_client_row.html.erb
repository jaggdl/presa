<div id="<%= dom_id(api_token, "client") %>" class="flex items-center justify-between gap-3 py-2 pl-2 pr-2 rounded-lg border-b border-zinc-800 <%= api_token.revoked? ? "hidden group-data-[clients-show-revoked-value=true]:flex" : "" %>">
  <div class="flex items-center gap-3 min-w-0">
    <span class="relative inline-flex items-center justify-center shrink-0 size-9 rounded-md bg-zinc-900 border border-zinc-700">
      <%= icon "bot", class: "size-5 text-zinc-400" %>
      <% if api_token.revoked? %>
        <span class="absolute -bottom-0.5 -right-0.5 inline-block size-3 rounded-full bg-red-500 border-2 border-zinc-800 shrink-0" title="Revoked"></span>
      <% elsif api_token.expired? %>
        <span class="absolute -bottom-0.5 -right-0.5 inline-block size-3 rounded-full bg-yellow-400 border-2 border-zinc-800 shrink-0" title="Expired"></span>
      <% else %>
        <span class="absolute -bottom-0.5 -right-0.5 inline-block size-3 rounded-full bg-green-400 border-2 border-zinc-800 shrink-0" title="Active"></span>
      <% end %>
    </span>
    <div class="min-w-0">
      <span class="flex items-center gap-2 font-medium text-zinc-100 min-w-0">
        <span data-controller="inline-edit" class="group relative inline-flex items-center min-w-0">
          <span data-inline-edit-target="value" class="truncate min-w-0"><%= api_token.name.presence || "Unnamed client" %></span>

          <button type="button" data-action="inline-edit#edit" data-inline-edit-target="button" aria-label="Edit name"
                  class="opacity-0 group-hover:opacity-100 transition text-zinc-500 hover:text-zinc-200 rounded p-1 ml-1 shrink-0" tabindex="0">
            <%= icon "pencil", class: "size-3.5" %>
          </button>

          <%= form_with model: api_token, url: workspace_api_token_path(workspace, api_token), method: :patch,
                data: { inline_edit_target: "form" }, class: "absolute left-0 top-0 z-20 w-48 hidden" do |form| %>
            <%= form.text_field :name, disabled: true,
                  data: { inline_edit_target: "field", action: "blur->inline-edit#save keydown.esc->inline-edit#cancel" },
                  placeholder: "Client name",
                  class: "w-full text-sm shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-2 py-0.5 bg-zinc-900" %>
          <% end %>
        </span>
      </span>
      <span class="block text-xs text-zinc-500">
        <%= pluralize(api_token.invocation_count, "invocation") %> in 24h
      </span>
    </div>
  </div>
  <div class="flex items-center justify-end gap-2 shrink-0">
    <span class="text-xs text-zinc-500">
      <% if api_token.last_used_at %>
        <%= time_ago_in_words(api_token.last_used_at) %> ago
      <% else %>
        Never used
      <% end %>
    </span>
    <% if api_token.active? %>
      <%= button_to workspace_api_token_path(workspace, api_token), method: :delete, class: "text-zinc-400 hover:text-red-400 transition shrink-0", "aria-label": "Revoke token", form: { data: { turbo_confirm: "Revoke this token?" } } do %>
        <%= icon "trash", class: "size-4" %>
      <% end %>
    <% end %>
  </div>
</div>