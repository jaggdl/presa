<tr id="<%= dom_id(api_token, "client") %>" class="border-b border-zinc-800 <%= api_token.revoked? ? "hidden group-data-[clients-show-revoked-value=true]:table-row" : "" %>">
  <td class="py-2 pl-2">
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center justify-center shrink-0 size-9 rounded-md bg-zinc-900 border border-zinc-700">
        <%= icon "bot", class: "size-5 text-zinc-400" %>
      </span>
      <div class="min-w-0">
        <span class="flex items-center gap-2 font-medium text-zinc-100">
          <span class="truncate"><%= api_token.name.presence || "Unnamed client" %></span>
          <% if api_token.revoked? %>
            <span class="inline-block size-2 rounded-full bg-red-500 shrink-0" title="Revoked"></span>
          <% elsif api_token.expired? %>
            <span class="inline-block size-2 rounded-full bg-yellow-400 shrink-0" title="Expired"></span>
          <% else %>
            <span class="inline-block size-2 rounded-full bg-green-400 shrink-0" title="Active"></span>
          <% end %>
        </span>
        <span class="block text-xs text-zinc-500">
          <%= pluralize(api_token.invocation_count, "invocation") %> in 24h
        </span>
      </div>
    </div>
  </td>
  <td class="py-2 text-right pr-2">
    <div class="flex items-center justify-end gap-2">
      <span class="text-xs text-zinc-500">
        <% if api_token.last_used_at %>
          <%= time_ago_in_words(api_token.last_used_at) %> ago
        <% else %>
          Never used
        <% end %>
      </span>
      <% if api_token.active? %>
        <%= button_to workspace_api_token_path(workspace, api_token), method: :delete, class: "text-zinc-400 hover:text-red-400 transition", "aria-label": "Revoke token", form: { data: { turbo_confirm: "Revoke this token?" } } do %>
          <%= icon "trash", class: "size-4" %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>