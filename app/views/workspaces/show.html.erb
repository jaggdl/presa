<div class="mx-auto md:w-3/4 w-full">
  <p class="text-sm text-zinc-500 mb-2">
    <%= link_to "Workspaces", workspaces_path, class: "text-blue-500 hover:underline" %>
  </p>

  <div class="min-w-0">
    <h1>
      <span data-controller="inline-edit"
            class="group relative inline-flex items-center">
        <span data-inline-edit-target="value" class="font-bold text-4xl leading-tight break-words">
          <%= @workspace.name.presence || "Unnamed workspace" %>
        </span>

        <button type="button" data-action="inline-edit#edit" data-inline-edit-target="button" aria-label="Edit name"
                class="opacity-0 group-hover:opacity-100 transition text-zinc-500 hover:text-zinc-200 rounded p-1" tabindex="0">
          <%= icon "pencil", class: "size-4" %>
        </button>

        <%= form_with model: @workspace, url: workspace_path(@workspace), method: :patch,
              data: { inline_edit_target: "form" }, class: "absolute left-0 top-0 z-20 hidden" do |form| %>
          <%= form.text_field :name, disabled: true,
                data: { inline_edit_target: "field", action: "blur->inline-edit#save keydown.esc->inline-edit#cancel" },
                placeholder: "Workspace name",
                class: "font-bold text-4xl leading-tight w-64 shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-2 py-0.5 bg-zinc-900" %>
        <% end %>
      </span>
    </h1>

    <div class="mt-2 max-w-xl">
      <span data-controller="inline-edit"
            class="group relative inline-flex items-start w-full">
        <span data-inline-edit-target="value" class="text-zinc-400 leading-relaxed <%= @workspace.description.presence ? "" : "italic" %>">
          <%= @workspace.description.presence || "Add a description" %>
        </span>

        <button type="button" data-action="inline-edit#edit" data-inline-edit-target="button" aria-label="Edit description"
                class="opacity-0 group-hover:opacity-100 transition text-zinc-500 hover:text-blue-200 rounded p-1 ml-1">
          <%= icon "pencil", class: "size-3.5" %>
        </button>

        <%= form_with model: @workspace, url: workspace_path(@workspace), method: :patch,
              data: { inline_edit_target: "form" }, class: "absolute left-0 top-0 z-20 w-full hidden" do |form| %>
          <%= form.text_area :description, rows: 2, disabled: true,
                data: { inline_edit_target: "field", action: "blur->inline-edit#save keydown.esc->inline-edit#cancel" },
                placeholder: "Optional description",
                class: "w-full shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-900" %>
        <% end %>
      </span>
    </div>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
    <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-4">
      <div class="flex items-center gap-2">
        <%= icon "wrench", class: "size-5 text-zinc-400" %>
        <span class="text-2xl font-bold"><%= @allowed_tools_count %></span>
        <% weight = tool_weight_level(@allowed_tools_count) %>
        <span class="flex items-center gap-1 text-xs <%= weight[:text] %>" title="Tool weight">
          <%= icon weight[:icon], class: "size-3.5" %>
          <%= weight[:label] %>
        </span>
      </div>
      <div class="text-sm text-zinc-500 mt-1">Allowed tools</div>
    </div>
    <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-4">
      <div class="flex items-center gap-2">
        <%= icon "activity", class: "size-5 text-zinc-400" %>
        <span class="text-2xl font-bold"><%= @workspace.invocation_count %></span>
      </div>
      <div class="text-sm text-zinc-500 mt-1">Invocations in 24h</div>
    </div>
    <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-4">
      <div class="flex items-center gap-2">
        <%= icon "circle-alert", class: "size-5 text-zinc-400" %>
        <span class="text-2xl font-bold"><%= @workspace.error_count %></span>
      </div>
      <div class="text-sm text-zinc-500 mt-1">Errors in 24h</div>
    </div>
    <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-4">
      <div class="flex items-center gap-2">
        <%= icon "users", class: "size-5 text-zinc-400" %>
        <span class="text-2xl font-bold"><%= @workspace.api_token_count %></span>
      </div>
      <div class="text-sm text-zinc-500 mt-1">Clients</div>
    </div>
  </div>

  <div class="grid grid-cols-1 xl:grid-cols-2 gap-6 mt-8">

    <section class="min-w-0">
  <h2 class="font-bold text-2xl">Clients</h2>

  <div data-controller="clients" data-clients-show-revoked-value="false" class="group">
    <div class="flex items-center justify-between mt-3">
      <% if @api_tokens.any? %>
        <button type="button" data-action="clients#toggle" title="Toggle revoked clients" class="text-zinc-400 hover:text-zinc-200 transition flex items-center gap-1.5" aria-label="Toggle revoked clients">
          <span class="inline group-data-[clients-show-revoked-value=true]:hidden"><%= icon "eye", class: "size-5" %></span>
          <span class="hidden group-data-[clients-show-revoked-value=true]:block"><%= icon "eye-off", class: "size-5" %></span>
          <span class="text-sm">revoked</span>
        </button>
      <% else %>
        <span></span>
      <% end %>

      <div class="flex items-center gap-2">
        <button type="button" data-action="clients#open" class="text-center rounded-md px-2.5 py-1.5 text-sm bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 inline-block font-medium cursor-pointer">Connect via MCP</button>
        <button type="button" data-action="clients#openSkill" class="text-center rounded-md px-2.5 py-1.5 text-sm bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 inline-block font-medium cursor-pointer">Connect via skill</button>
      </div>
    </div>

    <table class="w-full text-left mt-2">
      <tbody id="clients-table-body">
        <% if @api_tokens.any? %>
          <%= render partial: "client_row", collection: @api_tokens, as: :api_token, locals: { workspace: @workspace } %>
        <% else %>
          <tr id="clients-empty">
            <td class="py-4 text-zinc-500">No clients connected yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= render "shared/dialog", controller: "clients" do %>
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-bold text-xl">Connect a client</h3>
        <button type="button" data-action="clients#close" class="text-zinc-400 hover:text-zinc-200 transition" aria-label="Close">
          <%= icon "x", class: "size-5" %>
        </button>
      </div>

      <div data-clients-target="mcpPanel">
        <div class="flex flex-wrap gap-1 mb-4">
          <button type="button" data-action="clients#select" data-panel="mcp" class="px-2.5 py-1 rounded-md border border-blue-500 text-white bg-blue-500/20 text-xs">MCP</button>
          <button type="button" data-action="clients#select" data-panel="skill" class="px-2.5 py-1 rounded-md border border-zinc-700 text-zinc-400 text-xs">Skill</button>
        </div>
        <div id="client_form">
          <%= form_with model: @api_token, url: workspace_api_tokens_path(@workspace) do |form| %>
            <div class="mb-4">
              <%= form.label :name, "Client name", class: "block text-sm text-zinc-400 mb-1" %>
              <%= form.text_field :name, placeholder: "e.g. Cursor", id: "client_modal_name", class: "block w-full shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-800" %>
            </div>
            <div class="flex justify-end">
              <%= form.submit "Create client", id: "client_modal_submit", class: "btn-primary" %>
            </div>
          <% end %>
        </div>
        <div id="client-modal-result" class="mt-4"></div>
      </div>

      <div data-clients-target="skillPanel" class="hidden">
        <div class="flex flex-wrap gap-1 mb-4">
          <button type="button" data-action="clients#select" data-panel="mcp" class="px-2.5 py-1 rounded-md border border-zinc-700 text-zinc-400 text-xs">MCP</button>
          <button type="button" data-action="clients#select" data-panel="skill" class="clients-skill-tab px-2.5 py-1 rounded-md border border-blue-500 text-white bg-blue-500/20 text-xs">Skill</button>
        </div>
        <%= render "skill_instructions", workspace: @workspace, skill_url: @skill_url, share_code: @share_code %>
      </div>
    <% end %>
  </div>

    </section>

    <section class="min-w-0">
  <h2 class="font-bold text-2xl">Services</h2>

  <% if @linked_services.any? %>
    <table class="w-full text-left mt-4">
      <tbody>
        <% @linked_services.each do |service| %>
          <tr class="relative border-b border-zinc-800 transition hover:bg-zinc-800/50 focus-within:bg-zinc-800/50">
            <td class="py-2 pl-2">
              <div class="flex items-center gap-3">
                <span class="relative flex-shrink-0">
                  <%= service_icon(service, size: :md) %>
                  <% if join = @ws_links[service.id] %>
                    <%= render "shared/tool_count_badge", title: "Enabled tools", count: join.enabled_tool_count(ApplicationTool.expose_for(join.service)), label: "enabled" %>
                  <% end %>
                </span>
                <div>
                  <span class="block font-medium text-zinc-100"><%= service.name %></span>
                  <div class="text-xs text-zinc-500"><%= service.kind %></div>
                </div>
              </div>
            </td>
            <td class="py-2 text-right pr-2">
              <div class="flex items-center justify-end gap-3">
                <span class="text-xs text-zinc-500"><%= pluralize(service.invocation_count, "invocation") %> in 24h</span>
                <span class="relative z-10">
                  <%= button_to workspace_workspace_service_path(@workspace, service.id), method: :delete, class: "text-zinc-400 hover:text-red-400 transition", form: { data: { turbo_confirm: "Remove this service from the workspace?" } }, "aria-label": "Remove service" do %>
                    <%= icon "unlink", class: "size-5" %>
                  <% end %>
                </span>
              </div>
            </td>
            <% if join = @ws_links[service.id] %>
              <td>
                <%= link_to "", workspace_workspace_service_path(@workspace, join), class: "absolute inset-0", aria: { label: service.name } %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-4">No services linked to this workspace.</p>
  <% end %>

  <% if @available_services.any? %>
    <div data-controller="add-service">
      <button type="button" data-action="add-service#open"
              class="w-full flex items-center justify-center gap-2 py-2 text-center text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900 font-medium cursor-pointer">
        <%= icon "plus", class: "size-4" %>
        Add service
      </button>

      <%= render "shared/dialog", controller: "add-service", id: "add-service-dialog", width_class: "w-[28rem]" do %>
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-bold text-xl">Add service</h3>
          <button type="button" data-action="add-service#close" class="text-zinc-400 hover:text-zinc-200 transition" aria-label="Close">
            <%= icon "x", class: "size-5" %>
          </button>
        </div>

        <div class="relative mb-3">
          <%= icon "search", class: "size-4 absolute left-3 top-1/2 -translate-y-1/2 text-zinc-500" %>
          <input type="search" data-add-service-target="input" data-action="input->add-service#filter"
                 placeholder="Search services"
                 class="w-full pl-9 pr-3 py-2 rounded-md border border-zinc-700 bg-zinc-800 text-zinc-100 focus:outline-blue-600 placeholder-zinc-500">
        </div>

        <div class="overflow-y-auto h-72 -mx-6 px-6">
          <% @available_services.each do |service| %>
            <%= button_to workspace_workspace_services_path(@workspace, service_id: service.id), method: :post, class: "w-full text-left block border-b border-zinc-800 hover:bg-zinc-800/50 transition", data: { add_service_target: "row", search: "#{service.name.downcase} #{service.kind.downcase}" } do %>
              <span class="flex items-center gap-3 py-2">
                <span class="relative flex-shrink-0">
                  <%= service_icon(service, size: :md) %>
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block text-zinc-100"><%= service.name %></span>
                  <span class="block text-xs text-zinc-500"><%= service.kind %></span>
                </span>
                <%= icon "plus", class: "size-4 shrink-0 text-zinc-500" %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

    </section>
  </div>
  <div class="flex items-center justify-between mt-10">
    <h2 class="font-bold text-2xl">Tool invocations</h2>

    <%= render "log_tool_data_switch", workspace: @workspace %>
  </div>

  <%= turbo_stream_from "invocations_#{@workspace.id}" %>

  <%= render "tool_invocations_log", workspace: @workspace, tool_invocations: @tool_invocations %>