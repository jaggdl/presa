<div class="mx-auto md:w-3/4 w-full">
  <p class="text-sm text-zinc-500 mb-2">
    <%= link_to "Workspaces", workspaces_path, class: "text-blue-500 hover:underline" %>
  </p>
  <h1 class="font-bold text-4xl"><%= @workspace.name.presence || "Unnamed workspace" %></h1>

  <h2 class="font-bold text-2xl mt-10">Services</h2>

  <% if @linked_services.any? %>
    <table class="w-full text-left mt-4">
      <tbody>
        <% @linked_services.each do |service| %>
          <tr class="border-b border-zinc-800">
            <td class="py-2">
              <div class="flex items-center gap-3">
                <%= service_icon(service, size: "h-5 w-5") %>
                <%= link_to service.name, service_path(service), class: "text-blue-500 hover:underline" %>
                <span class="text-zinc-500"><%= service.kind %></span>
              </div>
            </td>
            <td class="py-2 text-right">
              <div class="flex items-center justify-end gap-3">
                <span class="text-xs text-zinc-500"><%= pluralize(service.invocation_count, "invocation") %> in 24h</span>
                <%= button_to workspace_workspace_service_path(@workspace, service.id), method: :delete, class: "text-zinc-400 hover:text-red-400 transition", form: { data: { turbo_confirm: "Remove this service from the workspace?" } }, "aria-label": "Remove service" do %>
                  <%= icon "unlink", class: "size-5" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-4">No services linked to this workspace.</p>
  <% end %>

  <% if @available_services.any? %>
    <%= form_with url: workspace_workspace_services_path(@workspace), class: "contents mt-4" do |form| %>
      <div class="my-4 flex items-center gap-3">
        <%= form.select :service_id, @available_services.map { |s| ["#{s.name} (#{s.kind})", s.id] }, {}, class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-900" %>
        <%= form.submit "Add service", class: "text-center rounded-md px-3.5 py-2.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-100 inline-block font-medium cursor-pointer" %>
      </div>
    <% end %>
  <% end %>

  <h2 class="font-bold text-2xl mt-10">Tool invocations</h2>

  <% if @tool_invocations.any? %>
    <table class="w-full text-left mt-4">
      <thead>
        <tr class="border-b border-zinc-800 text-sm text-zinc-500">
          <th class="py-2">Time</th>
          <th class="py-2">Tool</th>
          <th class="py-2">Service</th>
          <th class="py-2">Token</th>
          <th class="py-2">Status</th>
          <th class="py-2">Duration</th>
          <th class="py-2">Arguments</th>
        </tr>
      </thead>
      <tbody>
        <% @tool_invocations.each do |invocation| %>
          <tr class="border-b border-zinc-800">
            <td class="py-2"><%= invocation.created_at.strftime("%b %d, %Y %H:%M:%S") %></td>
            <td class="py-2"><%= invocation.tool_name %></td>
            <td class="py-2"><%= invocation.service&.name.presence || "–" %></td>
            <td class="py-2"><%= invocation.api_token.name.presence || "–" %></td>
            <td class="py-2">
              <% if invocation.success? %>
                <span class="text-green-400">Success</span>
              <% else %>
                <span class="text-red-500">Error</span>
              <% end %>
            </td>
            <td class="py-2"><%= invocation.duration_ms ? "#{invocation.duration_ms} ms" : "–" %></td>
            <td class="py-2"><code class="text-sm text-zinc-400"><%= truncate(JSON.generate(invocation.arguments), length: 80) %></code></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-4">No tool invocations yet.</p>
  <% end %>

  <h2 class="font-bold text-2xl mt-10">API tokens</h2>

  <%= form_with model: @api_token, url: workspace_api_tokens_path(@workspace), class: "contents" do |form| %>
    <div class="my-5">
      <%= form.text_field :name, placeholder: "Token name (e.g. Cursor)", class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 mt-2 w-full bg-zinc-900" %>
    </div>

    <div class="inline">
      <%= form.submit "Create token", class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-10">
    <% if @api_tokens.any? %>
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-zinc-800 text-sm text-zinc-500">
            <th class="py-2">Name</th>
            <th class="py-2">Created</th>
            <th class="py-2">Last used</th>
            <th class="py-2">Expires</th>
            <th class="py-2">Status</th>
            <th class="py-2"></th>
          </tr>
        </thead>
        <tbody>
          <% @api_tokens.each do |api_token| %>
            <tr class="border-b border-zinc-800">
              <td class="py-2"><%= api_token.name.presence || "–" %></td>
              <td class="py-2"><%= api_token.created_at && api_token.created_at.strftime("%b %d, %Y") %></td>
              <td class="py-2">
                <% if api_token.last_used_at %>
                  <%= api_token.last_used_at.strftime("%b %d, %Y %H:%M") %>
                <% else %>
                  <span class="text-zinc-500">never</span>
                <% end %>
              </td>
              <td class="py-2">
                <% if api_token.expires_at %>
                  <%= api_token.expires_at.strftime("%b %d, %Y") %>
                <% else %>
                  <span class="text-zinc-500">never</span>
                <% end %>
              </td>
              <td class="py-2">
                <% if api_token.revoked? %>
                  <span class="text-red-500">Revoked</span>
                <% elsif api_token.expired? %>
                  <span class="text-yellow-400">Expired</span>
                <% else %>
                  <span class="text-green-400">Active</span>
                <% end %>
              </td>
              <td class="py-2 text-right">
                <% if api_token.active? %>
                  <%= button_to "Revoke", workspace_api_token_path(@workspace, api_token), method: :delete, class: "text-red-500 underline hover:no-underline", form: { data: { turbo_confirm: "Revoke this token?" } } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-zinc-500">No API tokens yet.</p>
    <% end %>
  </div>
</div>