<div class="mx-auto md:w-3/4 w-full">
  <p class="text-sm text-zinc-500 mb-2">
    <%= link_to "Workspaces", workspaces_path, class: "text-blue-500 hover:underline" %>
  </p>
  <h1 class="font-bold text-4xl"><%= @workspace.name.presence || "Unnamed workspace" %></h1>

  <h2 class="font-bold text-2xl mt-10">Services</h2>

  <% if @linked_services.any? %>
    <table class="w-full text-left mt-4">
      <tbody>
        <% @linked_services.each do |service| %>
          <tr class="border-b border-zinc-800">
            <td class="py-2">
              <div class="flex items-center gap-3">
                <%= service_icon(service, size: "h-5 w-5") %>
                <% if join = @ws_links[service.id] %>
                  <%= link_to service.name, workspace_workspace_service_path(@workspace, join), class: "text-blue-500 hover:underline" %>
                <% else %>
                  <span class="text-zinc-100"><%= service.name %></span>
                <% end %>
                <span class="text-zinc-500"><%= service.kind %></span>
              </div>
            </td>
            <td class="py-2 text-right">
              <div class="flex items-center justify-end gap-3">
                <span class="text-xs text-zinc-500"><%= pluralize(service.invocation_count, "invocation") %> in 24h</span>
                <%= button_to workspace_workspace_service_path(@workspace, service.id), method: :delete, class: "text-zinc-400 hover:text-red-400 transition", form: { data: { turbo_confirm: "Remove this service from the workspace?" } }, "aria-label": "Remove service" do %>
                  <%= icon "unlink", class: "size-5" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-zinc-500 mt-4">No services linked to this workspace.</p>
  <% end %>

  <% if @available_services.any? %>
    <%= form_with url: workspace_workspace_services_path(@workspace), class: "contents mt-4" do |form| %>
      <div class="my-4 flex items-center gap-3">
        <%= form.select :service_id, @available_services.map { |s| ["#{s.name} (#{s.kind})", s.id] }, {}, class: "block shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-900" %>
        <%= form.submit "Add service", class: "text-center rounded-md px-3.5 py-2.5 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-100 inline-block font-medium cursor-pointer" %>
      </div>
    <% end %>
  <% end %>

  <h2 class="font-bold text-2xl mt-10">Clients</h2>

  <p class="text-sm text-zinc-500 mt-1">Each client connects with its own API token to use this workspace's tools.</p>

  <div data-controller="clients" data-clients-show-revoked-value="false" class="group">
    <div class="flex items-center justify-between mt-3">
      <% if @api_tokens.any? %>
        <button type="button" data-action="clients#toggle" title="Toggle revoked clients" class="text-zinc-400 hover:text-zinc-200 transition flex items-center gap-1.5" aria-label="Toggle revoked clients">
          <span class="inline group-data-[clients-show-revoked-value=true]:hidden"><%= icon "eye", class: "size-5" %></span>
          <span class="hidden group-data-[clients-show-revoked-value=true]:block"><%= icon "eye-off", class: "size-5" %></span>
          <span class="text-sm">revoked</span>
        </button>
      <% else %>
        <span></span>
      <% end %>

      <button type="button" data-action="clients#open" class="text-center rounded-md px-2.5 py-1.5 text-sm bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 text-zinc-300 inline-block font-medium cursor-pointer">Connect client</button>
    </div>

    <table class="w-full text-left mt-2">
      <tbody id="clients-table-body">
        <% if @api_tokens.any? %>
          <%= render partial: "client_row", collection: @api_tokens, as: :api_token, locals: { workspace: @workspace } %>
        <% else %>
          <tr id="clients-empty">
            <td class="py-4 text-zinc-500">No clients connected yet.</td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <dialog data-clients-target="dialog"
            data-action="click->clients#backdrop"
            class="m-auto p-0 rounded-lg bg-transparent border-0 backdrop:bg-black/60 data-[open]:backdrop:bg-black/60 open:backdrop:bg-black/60">
      <div class="p-6 rounded-lg bg-zinc-900 text-zinc-100 border border-zinc-700 w-96">
        <div class="flex items-center justify-between mb-4">
          <h3 class="font-bold text-xl">Connect a client</h3>
          <button type="button" data-action="clients#close" class="text-zinc-400 hover:text-zinc-200 transition" aria-label="Close">
            <%= icon "x", class: "size-5" %>
          </button>
        </div>

        <div id="client_form">
          <%= form_with model: @api_token, url: workspace_api_tokens_path(@workspace) do |form| %>
            <div class="mb-4">
              <%= form.label :name, "Client name", class: "block text-sm text-zinc-400 mb-1" %>
              <%= form.text_field :name, placeholder: "e.g. Cursor", id: "client_modal_name", class: "block w-full shadow-sm rounded-md border border-zinc-700 focus:outline-blue-600 px-3 py-2 bg-zinc-800" %>
            </div>
            <%= form.submit "Create client", id: "client_modal_submit", class: "btn-primary" %>
          <% end %>
        </div>

        <div id="client-modal-result" class="mt-4"></div>
      </div>
    </dialog>
  </div>

  <h2 class="font-bold text-2xl mt-10">Tool invocations</h2>

  <%= turbo_stream_from "invocations_#{@workspace.id}" %>

  <div class="mt-4 rounded-md border border-zinc-700 bg-black font-mono text-xs overflow-x-auto">
    <div class="max-h-80 overflow-y-auto">
      <ul id="tool-invocations" class="divide-y divide-zinc-800/60">
        <% if @tool_invocations.any? %>
          <%= render partial: "tool_invocations/invocation", collection: @tool_invocations %>
        <% else %>
          <li id="tool-invocations-empty" class="px-4 py-3 text-zinc-500">No tool invocations yet.</li>
        <% end %>
      </ul>
      <div id="invocations-more" class="border-t border-zinc-800">
        <% if @tool_invocations.size >= 50 %>
          <%= link_to "Load more", invocations_workspace_path(@workspace, before_id: @tool_invocations.last.id), data: { turbo_stream: true }, class: "block px-4 py-2 text-center text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900" %>
        <% end %>
      </div>
    </div>
  </div>