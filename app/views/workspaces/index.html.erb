<div class="mx-auto md:w-3/4 w-full">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-4xl">Workspaces</h1>

    <%= link_to "New workspace", new_workspace_path, class: "text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium" %>
  </div>

  <% if @workspaces.any? %>
    <ul class="mt-6">
      <% @workspaces.each do |workspace| %>
        <li class="flex items-center gap-3 py-3 border-b border-zinc-800">
          <%= service_icon_stack(workspace.services) %>
          <%= link_to workspace.name.presence || "Unnamed workspace", workspace, class: "text-blue-500 hover:underline" %>
          <% stats = workspace %>
          <span class="ml-auto text-xs text-zinc-500">
            <%= pluralize(workspace.api_token_count, "client") %> · <%= pluralize(workspace.invocation_count, "invocation") %> in 24h
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-zinc-500 mt-6">No workspaces yet.</p>
  <% end %>
</div>