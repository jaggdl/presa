<div class="mx-auto md:w-3/4 w-full">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-4xl">Workspaces</h1>

    <%= link_to "New workspace", new_workspace_path, class: "btn-primary" %>
  </div>

  <% if @workspaces.any? %>
    <ul class="mt-6">
      <% @workspaces.each do |workspace| %>
        <li class="relative flex items-center gap-3 py-3 pl-2 pr-2 border-b border-zinc-800 transition hover:bg-zinc-800/50 focus-within:bg-zinc-800/50">
          <%= service_icon_stack(workspace.services) %>
          <span class="font-medium text-zinc-100"><%= workspace.name.presence || "Unnamed workspace" %></span>
          <span class="ml-auto text-xs text-zinc-500">
            <%= pluralize(workspace.api_token_count, "client") %> · <%= pluralize(workspace.invocation_count, "invocation") %> in 24h
          </span>
          <%= link_to "", workspace, class: "absolute inset-0", aria: { label: workspace.name.presence || "Unnamed workspace" } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-zinc-500 mt-6">No workspaces yet.</p>
  <% end %>
</div>