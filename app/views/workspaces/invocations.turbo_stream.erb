<%= turbo_stream.append "tool-invocations" do %>
  <%= render partial: "tool_invocations/invocation", collection: @tool_invocations, locals: { workspace: @workspace, logging_disabled: !@workspace.log_tool_data } %>
<% end %>

<%= turbo_stream.update "invocations-more" do %>
  <% if @tool_invocations.size >= 50 %>
    <%= link_to "Load more", invocations_workspace_path(@workspace, before_id: @tool_invocations.last.id), data: { turbo_stream: true }, class: "block px-4 py-2 text-center text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900" %>
  <% end %>
<% end %>